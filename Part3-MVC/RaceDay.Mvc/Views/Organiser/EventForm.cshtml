@model EventFormViewModel
@{
    var isEdit = Model.EventId > 0;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}
<div class="container py-4">
    <p class="eyebrow">Organiser</p>
    <h1 class="page-title">@ViewData["Title"]</h1>

    <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" method="post" enctype="multipart/form-data" class="panel" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="EventId" />
        <input type="hidden" asp-for="HasBanner" />

        <div class="row g-3">
            <div class="col-12 col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="field-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-error"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" />
                <span asp-validation-for="EventDate" class="field-error"></span>
            </div>
            <div class="col-12 col-md-5">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="field-error"></span>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                <span asp-validation-for="DistanceKm" class="field-error"></span>
            </div>
            @if (isEdit)
            {
                <div class="col-12 col-md-4">
                    <label asp-for="Status" class="form-label">Event status</label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var s in new[] { "Planned", "Open", "Closed", "Completed", "Cancelled" })
                        {
                            <option value="@s" selected="@(Model.Status == s)">@s</option>
                        }
                    </select>
                    <div class="form-text">Participants can only enrol while the event is Planned or Open.</div>
                </div>
            }
            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (isEdit && Model.HasBanner)
                {
                    <div class="mb-2"><img class="banner-preview" src="@Url.Action("EventBanner", "Images", new { id = Model.EventId })" alt="Current banner image" /></div>
                }
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" data-max-mb="5" />
                <div class="form-text">Optional. JPG, PNG or WEBP, up to 5 MB. @(isEdit && Model.HasBanner ? "Choosing a new file replaces the current banner." : "")</div>
                <span asp-validation-for="Banner" class="field-error"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
            <a class="btn btn-outline-dark" asp-action="Events">Cancel</a>
        </div>
    </form>
</div>
