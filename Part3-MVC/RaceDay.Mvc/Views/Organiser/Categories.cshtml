@model CategoriesViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Categories – " + ev.Name;
}
<div class="container py-4">
    <p class="eyebrow">@ev.Name · @Format.Date(ev.EventDate)</p>
    <h1 class="page-title">Categories</h1>
    <p class="text-muted">Add age or distance categories (for example Under 20, Senior, 10km or 21km) so participants can choose where to enter.</p>

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <h2 class="section-title mb-3">Current categories</h2>
            @if (ev.Categories is null || !ev.Categories.Any())
            {
                <div class="state-card">No categories yet. Add the first one using the form.</div>
            }
            else
            {
                <div class="table-responsive panel p-0">
                    <table class="table rd-table align-middle mb-0">
                        <thead><tr><th scope="col">Category</th><th scope="col">Distance</th><th scope="col">Start</th><th scope="col">Places</th><th scope="col">Fee</th><th scope="col"></th></tr></thead>
                        <tbody>
                            @foreach (var c in ev.Categories)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>@c.DistanceKm.ToString("0.##") km</td>
                                    <td>@Format.ShortTime(c.StartTime)</td>
                                    <td>@c.MaxParticipants</td>
                                    <td>@Format.Money(c.Fee)</td>
                                    <td class="text-end">
                                        <form asp-action="DeleteCategory" method="post" data-confirm="Delete the category &quot;@c.Name&quot;?">
                                            <input type="hidden" name="eventId" value="@ev.EventId" />
                                            <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="mt-3 d-flex gap-2">
                <a class="btn btn-outline-dark" asp-action="Events">Back to my events</a>
                <a class="btn btn-outline-dark" asp-action="Enrolments" asp-route-eventId="@ev.EventId">View enrolments</a>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <form asp-action="AddCategory" method="post" class="panel" novalidate>
                <h2 class="section-title mb-3">Add a category</h2>
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="NewCategory.EventId" />
                <div class="mb-3">
                    <label asp-for="NewCategory.Name" class="form-label"></label>
                    <input asp-for="NewCategory.Name" class="form-control" placeholder="e.g. Under 20" />
                    <span asp-validation-for="NewCategory.Name" class="field-error"></span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="NewCategory.DistanceKm" class="field-error"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
                        <input asp-for="NewCategory.MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="NewCategory.MaxParticipants" class="field-error"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.Fee" class="form-label"></label>
                        <input asp-for="NewCategory.Fee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="NewCategory.Fee" class="field-error"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="NewCategory.StartTime" class="form-label"></label>
                        <input asp-for="NewCategory.StartTime" type="time" class="form-control" />
                        <span asp-validation-for="NewCategory.StartTime" class="field-error"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-rd w-100 mt-4">Add category</button>
            </form>
        </div>
    </div>
</div>
